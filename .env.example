# Supabase Auth public values from the existing shared project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Dedicated crossplay_runtime connection through Supavisor transaction mode (port 6543).
# Never use the shared postgres password or service role in the app.
CROSSPLAY_DATABASE_URL=
# Random secret of at least 32 characters for rate-limit keys and retry-safe invitation issuance.
CROSSPLAY_RATE_LIMIT_SECRET=
# Exact public origin; no trailing slash. Set separately for each deployment environment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Test-only, loopback PostgreSQL may disable TLS. Hosted deployments always require TLS.
# CROSSPLAY_DATABASE_SSL=false
